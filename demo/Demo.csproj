<Project Sdk="Microsoft.NET.Sdk">
  <!-- A self-contained publish for a runtime identifier runs on Satori; other builds keep the stock GC. -->
  <Sdk Name="PublishWithSatoriGC" Version="10.0.14-satori.40433706833.1" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The PDB goes into Demo.dll, so a dump of the demo carries the source lines of its awaits. -->
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>
</Project>
